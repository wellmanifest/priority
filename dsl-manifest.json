{
  "$schema": "https://wellmanifest.com/schemas/dsl-manifest/v1",
  "schema": "wellmanifest.dsl/manifest/v1",
  "id": "wellmanifest.priority",
  "name": "Wellmanifest priority and intent-evolution DSL",
  "version": "0.1.0-dev",
  "status": "experimental",
  "purpose": "Declare standing priorities, the signals that reweight them, and the amendments by which the intent itself is revised. Propose-only: it ranks and explains, it never edits.",
  "domain": "software-prioritization",
  "owners": [
    {
      "kind": "repository",
      "id": "github:wellmanifest/priority",
      "responsibilities": [
        "semantics",
        "validation",
        "compatibility"
      ]
    }
  ],
  "source": {
    "repository": "https://github.com/wellmanifest/priority",
    "path": "schemas/priority.schema.json",
    "declaredVersion": "1",
    "canonical": "json-ast",
    "mediaType": "application/schema+json",
    "selectors": []
  },
  "ownedPaths": [
    "docs/**",
    "dsl-manifest.json",
    "examples/**",
    "schemas/**",
    "src/priority.py"
  ],
  "namespaces": [
    {
      "prefix": "wellmanifest",
      "uri": "https://wellmanifest.com/"
    },
    {
      "prefix": "priority",
      "uri": "https://wellmanifest.com/priority/"
    }
  ],
  "projections": [
    {
      "name": "document-priority-text",
      "mediaType": "text/plain",
      "direction": "bidirectional",
      "lossless": true
    },
    {
      "name": "agent-instructions",
      "mediaType": "text/markdown",
      "direction": "from-canonical",
      "lossless": false
    },
    {
      "name": "ranking-json",
      "mediaType": "application/json",
      "direction": "from-canonical",
      "lossless": false
    }
  ],
  "lifecycle": {
    "compatibility": "semver",
    "stability": "experimental",
    "breaking": "major",
    "additive": "minor",
    "fix": "patch"
  },
  "semantics": {
    "effectModel": "propose-only",
    "unknownPolicy": "reject",
    "authoritySchema": null
  },
  "llm": {
    "mode": "none",
    "requestSchemas": [],
    "responseSchemas": [],
    "naturalLanguage": "typed-source-only",
    "sourceSchema": "wellmanifest.priority/v1",
    "modelAuthority": "none",
    "strict": true
  },
  "documentation": {
    "vocabularyKind": "commands",
    "commandRoot": "docs",
    "errorRoot": "docs/ERROR",
    "criticalRoot": "docs/CRITICAL",
    "commands": [
      "PRIORITY",
      "SIGNAL",
      "RELATION",
      "AMEND"
    ],
    "errorCodes": [
      "PRIORITY-KIND-001",
      "PRIORITY-SIGNAL-001",
      "PRIORITY-SIGNAL-002",
      "PRIORITY-SIGNAL-003",
      "PRIORITY-TIER-001",
      "PRIORITY-TIER-002",
      "PRIORITY-INTENT-001",
      "PRIORITY-INTENT-002",
      "PRIORITY-INTENT-003",
      "PRIORITY-WEIGHT-001",
      "PRIORITY-RULE-001",
      "PRIORITY-RULE-002",
      "PRIORITY-RULE-003",
      "PRIORITY-AMEND-001",
      "PRIORITY-AMEND-002",
      "PRIORITY-RELATION-001",
      "PRIORITY-PROJECTION-001"
    ],
    "criticalCodes": [
      "PRIORITY-EFFECT-001"
    ]
  },
  "findingPolicy": {
    "schema": "wellmanifest.dsl/findings/v1",
    "requiredProducers": [
      "wellmanifest.priority.validator"
    ],
    "securityProducers": [
      "wellmanifest.priority.validator"
    ],
    "blockingSeverities": [
      "critical"
    ],
    "requireEvaluable": true,
    "blockUnresolvedSecurity": true
  },
  "publicationPolicy": {
    "declaredTier": "review",
    "deterministic": true,
    "independentReview": true,
    "externalAuthority": false,
    "runtimeIsolation": false
  },
  "conformance": {
    "levels": [
      "manifest",
      "contract"
    ],
    "commands": [
      "PYTHONPATH=src python3 -m priority validate examples/standardization.priority.dsl",
      "PYTHONPATH=src python3 -m unittest discover -s tests"
    ],
    "validExamples": [
      "examples/standardization.priority.dsl"
    ],
    "invalidExamples": [
      "examples/invalid/unsourced-signal.priority.dsl"
    ]
  },
  "mappings": [
    {
      "standard": "wellmanifest.dsl",
      "version": "0.1.0-dev",
      "relation": "implements",
      "uri": "https://github.com/wellmanifest/dsl"
    },
    {
      "standard": "wellmanifest.project-ssot",
      "version": "0.2.0-dev",
      "relation": "compatible-with",
      "uri": "https://github.com/wellmanifest/project-ssot"
    },
    {
      "standard": "wellmanifest.new-project",
