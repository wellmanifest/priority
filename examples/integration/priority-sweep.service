[Unit]
Description=Priority sweep (read-only)

[Service]
Type=oneshot
WorkingDirectory=%h/workspace
# propose-only: an adopter-owned producer step writes the typed readings file.
# The evaluator emits a receipt and reports projection drift; it edits nothing.
ExecStart=/usr/bin/env priority receipt priority.dsl --readings .priority/readings.json
ExecStart=/usr/bin/env priority check priority.dsl --readings .priority/readings.json
SuccessExitStatus=0 1
