[Unit]
Description=Re-evaluate priorities and report proposed projection drift

[Timer]
# Five minutes is short enough to catch an expiry the same working session, and
# long enough that an adopter runtime can reuse observations whose WINDOW has
# not expired. Producer collection remains outside the evaluator.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
