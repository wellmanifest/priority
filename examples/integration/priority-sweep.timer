[Unit]
Description=Re-evaluate priorities and refresh agent projections

[Timer]
# Five minutes is short enough to catch an expiry the same working session, and
# long enough that signals with a multi-hour WINDOW are reused rather than
# re-taken. The cost of a tick is dominated by producers that actually expired.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
