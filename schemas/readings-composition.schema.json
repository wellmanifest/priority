{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/priority-readings-composition/v1",
  "title": "Wellmanifest priority readings composition receipt v1",
  "description": "Deterministic provenance binding partial producer envelopes to one final readings envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document", "sources", "output", "executionAuthorized", "receiptDigest"],
  "properties": {
    "schema": {"const": "wellmanifest.priority/readings-composition/v1"},
    "document": {"$ref": "#/$defs/documentRef"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "digest", "observedAt", "revision"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "digest": {"$ref": "#/$defs/digest"},
          "observedAt": {"type": "string", "format": "date-time", "maxLength": 40},
          "revision": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "output": {"$ref": "#/$defs/artifactRef"},
    "executionAuthorized": {"const": false},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "observedAt", "revision"],
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "observedAt": {"type": "string", "format": "date-time", "maxLength": 40},
        "revision": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    }
  }
}
