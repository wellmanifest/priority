{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/priority-readings/v1",
  "title": "Wellmanifest priority readings v1",
  "description": "Revision-bound observations supplied to the pure priority evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document", "observedAt", "revision", "readings"],
  "properties": {
    "schema": {"const": "wellmanifest.priority/readings/v1"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "observedAt": {"type": "string", "format": "date-time", "maxLength": 40},
    "revision": {"type": "string", "minLength": 1, "maxLength": 240},
    "readings": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
      "additionalProperties": {"$ref": "#/$defs/reading"}
    }
  },
  "$defs": {
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "producerRef"],
      "properties": {
        "observedAt": {"type": "string", "format": "date-time", "maxLength": 40},
        "activeSince": {"type": "string", "format": "date-time", "maxLength": 40},
        "producerRef": {"type": "string", "minLength": 1, "maxLength": 400},
        "value": {"type": ["number", "null"]},
        "changed": {"type": "boolean"}
      }
    }
  }
}
